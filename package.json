    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "react-leaflet": "^4.2.1",
    "react-remove-scroll": "^2.6.3",
