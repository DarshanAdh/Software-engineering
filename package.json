{
  "name": "roadside-caretakers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && vite",
    "dev:clean": "rm -rf node_modules/.vite && rm -rf dist && vite",
    "server": "cd server && npm run dev",
    "client": "rm -rf node_modules/.vite && vite",
    "start": "npm run dev:concurrent",
    "dev:concurrent": "concurrently \"npm run server\" \"npm run client\"",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
